        <!-- BOTTOM: FITUR MONITORING & KEAMANAN -->
        <!-- ========================================== -->
        <mxCell id="bottom_card" value="FITUR TRANSVERSAL: MONITORING REAL-TIME, AUDIT LOG &amp; HAK AKSES SISTEM" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#FFFFFF;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="1110" width="2130" height="150" as="geometry" />
        </mxCell>

        <mxCell id="card_mon1" value="&lt;b&gt;1. Dashboard &amp; Warning SLA&lt;/b&gt;&#xa;• SLA = 1 bulan kalender dari SPDP&#xa;• Batas tahun kalender mutlak menang&#xa;• Indikator visual kartu SLA Warning&#xa;• Widget Berkas DPO &amp; Trend Bulanan" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontFamily=Helvetica;fontSize=10;fontColor=#E2E8F0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1145" width="480" height="95" as="geometry" />
        </mxCell>

        <mxCell id="card_mon2" value="&lt;b&gt;2. Pencarian Cerdas &amp; Quick-View&lt;/b&gt;&#xa;• Live filter AJAX tanpa reload halaman&#xa;• Kolom pencarian mencakup: No Berkas, Tersangka, No Sprindik, No SPDP, &amp; Status&#xa;• Quick-View Modal: detail berkas, riwayat tahapan, &amp; dokumen PDF terlampir" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontFamily=Helvetica;fontSize=10;fontColor=#E2E8F0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="590" y="1145" width="500" height="95" as="geometry" />
        </mxCell>

        <mxCell id="card_mon3" value="&lt;b&gt;3. Audit Trail Terpusat (Audit Log)&lt;/b&gt;&#xa;• Pencatatan otomatis setiap aksi penting&#xa;• Finalisasi tahap, draft, upload dokumen, aktivasi/deaktivasi DPO dicatat detail&#xa;• Menyimpan User, IP, Timestamp, Data Lama &amp; Data Baru (Immutable / Tidak Bisa Diedit)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontFamily=Helvetica;fontSize=10;fontColor=#E2E8F0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1145" width="510" height="95" as="geometry" />
        </mxCell>

        <mxCell id="card_mon4" value="&lt;b&gt;4. Keamanan &amp; Integritas Data&lt;/b&gt;&#xa;• &lt;b&gt;TIDAK ADA HARD DELETE&lt;/b&gt; (Semua Soft Delete)&#xa;• &lt;b&gt;PENGUNCIAN TAHAP PERMANEN&lt;/b&gt;: Administrator pun TIDAK DAPAT mengedit/memundurkan tahap final&#xa;• RBAC: Penyidik (Input/Draft), Pimpinan (Read-Only), Admin (User &amp; Master)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontFamily=Helvetica;fontSize=10;fontColor=#E2E8F0;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1145" width="490" height="95" as="geometry" />
        </mxCell>


        <!-- ========================================== -->
        <!-- EDGES / CONNECTOR FLOWS -->
        <!-- ========================================== -->

        <!-- Start to Input LK -->
        <mxCell id="e_start_lk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_start" target="node_input_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input LK to Dec LK -->
        <mxCell id="e_lk_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_input_lk" target="node_dec_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec LK to Draft LK -->
        <mxCell id="e_lk_draft" value="Draft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="node_dec_lk" target="node_draft_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec LK to Final LK -->
        <mxCell id="e_lk_final" value="Finalkan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="node_dec_lk" target="node_final_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Final LK to Input Sprindik -->
        <mxCell id="e_final_lk_sprindik" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_final_lk" target="node_input_sprindik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input Sprindik to Dec 1 LK = 1 Sprindik -->
        <mxCell id="e_sprindik_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_input_sprindik" target="node_dec_sprindik_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec Sprindik: Sudah dipakai (Ya) -->
        <mxCell id="e_sprindik_err" value="Ya (Sudah dipakai)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#B91C1C;" edge="1" parent="1" source="node_dec_sprindik_lk" target="node_err_lk_used">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec Sprindik: Belum dipakai (Tidak) -> Bentuk Perkara -->
        <mxCell id="e_sprindik_ok" value="Belum (Valid 1-ke-1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="node_dec_sprindik_lk" target="node_bentuk_perkara">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bentuk Perkara to Bentuk Berkas -->
        <mxCell id="e_perkara_berkas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_bentuk_perkara" target="node_bentuk_berkas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bentuk Berkas to Berkas Ready -->
        <mxCell id="e_berkas_ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_bentuk_berkas" target="node_berkas_ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Transition: Berkas Ready to Input SPDP (Phase 1 to Phase 2) -->
        <mxCell id="e_trans_p1_p2" value="Mulai Progress Tahapan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2.5;fontFamily=Helvetica;fontStyle=1;fontSize=11;fontColor=#047857;" edge="1" parent="1" source="node_berkas_ready" target="node_input_spdp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="1007" />
              <mxPoint x="540" y="237" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Input SPDP to Dec SPDP -->
        <mxCell id="e_spdp_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="node_input_spdp" target="node_dec_spdp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec SPDP to Draft -->
        <mxCell id="e_spdp_draft" value="Draft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="node_dec_spdp" target="node_draft_spdp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec SPDP to Final -->
        <mxCell id="e_spdp_final" value="Simpan &amp; Lanjut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#047857;" edge="1" parent="1" source="node_dec_spdp" target="node_final_spdp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Final SPDP to Sub SPDP -->
        <mxCell id="e_spdp_sub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=1;dashed=1;" edge="1" parent="1" source="node_final_spdp" target="node_sub_spdp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sub SPDP to Input Tahap 1 -->
        <mxCell id="e_sub_tahap1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="node_sub_spdp" target="node_input_tahap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input Tahap 1 to Final Tahap 1 -->
        <mxCell id="e_tahap1_final" value="Simpan &amp; Lanjut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#047857;" edge="1" parent="1" source="node_input_tahap1" target="node_final_tahap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Final Tahap 1 to Sub Tahap 1 -->
        <mxCell id="e_tahap1_sub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=1;dashed=1;" edge="1" parent="1" source="node_final_tahap1" target="node_sub_tahap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sub Tahap 1 to Input P-21 -->
        <mxCell id="e_sub_p21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="node_sub_tahap1" target="node_input_p21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input P-21 to Final P-21 -->
        <mxCell id="e_p21_final" value="Simpan &amp; Lanjut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#047857;" edge="1" parent="1" source="node_input_p21" target="node_final_p21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Transition: Final P-21 to DPO Gate (Phase 2 to Phase 3) -->
        <mxCell id="e_trans_p2_p3" value="Menuju Tahap II (Cek DPO)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F59E0B;strokeWidth=2.5;fontFamily=Helvetica;fontStyle=1;fontSize=11;fontColor=#B45309;" edge="1" parent="1" source="node_final_p21" target="node_dec_dpo_gate">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="997" />
              <mxPoint x="1100" y="342" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- DPO Gate: Ya (Aktif) -->
        <mxCell id="e_dpo_yes" value="YA (DPO Aktif)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#B91C1C;" edge="1" parent="1" source="node_dec_dpo_gate" target="node_dpo_blocked">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DPO Gate: Tidak (Nonaktif) -->
        <mxCell id="e_dpo_no" value="TIDAK (Nonaktif)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#15803D;" edge="1" parent="1" source="node_dec_dpo_gate" target="node_dpo_passed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DPO Passed to Input Tahap 2 -->
        <mxCell id="e_dpo_passed_tahap2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F59E0B;strokeWidth=2;" edge="1" parent="1" source="node_dpo_passed" target="node_input_tahap2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input Tahap 2 to Final Tahap 2 -->
        <mxCell id="e_tahap2_final" value="Simpan &amp; Lanjut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2.5;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#15803D;" edge="1" parent="1" source="node_input_tahap2" target="node_final_tahap2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Final Tahap 2 to Keputusan Pengadilan -->
        <mxCell id="e_tahap2_vonis" value="Opsional Pasca Tahap II" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#1D4ED8;" edge="1" parent="1" source="node_final_tahap2" target="node_input_vonis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Keputusan Pengadilan to End Selesai -->
        <mxCell id="e_vonis_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="node_input_vonis" target="node_end_selesai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Direct Final Tahap 2 to End Selesai (if without vonis yet) -->
        <mxCell id="e_tahap2_direct_end" value="Otomatis Selesai" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=10;fontColor=#15803D;" edge="1" parent="1" source="node_final_tahap2" target="node_end_selesai">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1210" y="667" />
              <mxPoint x="1210" y="892" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ========================================== -->
        <!-- EDGES: PHASE 4 SCHEDULER & TIDAK SELESAI -->
        <!-- ========================================== -->

        <!-- Scheduler Trigger to Dec Annual Limit -->
        <mxCell id="e_sched_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="node_sched_trigger" target="node_dec_annual_limit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec Annual Limit: Selesai (Ya) -->
        <mxCell id="e_annual_yes" value="Sudah Selesai" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#047857;" edge="1" parent="1" source="node_dec_annual_limit" target="node_retain_selesai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec Annual Limit: Belum Selesai (Tidak) -> Trigger Tidak Selesai -->
        <mxCell id="e_annual_no" value="Belum Selesai (Melewati Batas Tahun)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#B91C1C;" edge="1" parent="1" source="node_dec_annual_limit" target="node_trigger_tidak_selesai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Trigger Tidak Selesai to Upload SP3 -->
        <mxCell id="e_tidak_selesai_sp3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;" edge="1" parent="1" source="node_trigger_tidak_selesai" target="node_upload_sp3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Upload SP3 to End Tidak Selesai -->
        <mxCell id="e_sp3_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;" edge="1" parent="1" source="node_upload_sp3" target="node_end_tidak_selesai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>