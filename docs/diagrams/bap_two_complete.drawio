        <mxCell id="e_sub_tahap1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" parent="1" source="node_sub_spdp" target="node_input_tahap1">
