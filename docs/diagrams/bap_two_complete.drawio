  <diagram id="baptwo-flowchart-diag" name="2. Flowchart Aplikasi">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2250" pageHeight="1450" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="header_card" value="FLOWCHART ALUR PENANGANAN PERKARA — SISTEM BAPTwo&#xa;Balai Besar Pengawas Obat dan Makanan (BBPOM) di Banjarmasin" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="2130" height="75" as="geometry" />
        </mxCell>

        <!-- LEGEND / KETERANGAN -->
        <mxCell id="legend_box" value="&lt;b&gt;LEGENDA:&lt;/b&gt;   &#xa;[Mulai / Selesai] : Kapsul Hijau/Merah  |  [Proses Operasional] : Persegi Biru  |  [Pengambilan Keputusan] : Belah Ketupat Oranye  |  [Aturan DPO Gate] : Merah/Amber  |  [Scheduler Otomatis] : Ungu  |  [Penguncian Tahap] : Otomatis &amp; Permanen" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#334155;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="2130" height="35" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- FASE 1: PRA-SPDP -->
        <!-- ========================================== -->
        <mxCell id="phase1_container" value="FASE 1: PRA-SPDP (Bobot Progress: 0%)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#0369A1;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="165" width="480" height="920" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="node_start" value="MULAI&#xa;(Login &amp; Math Captcha)" style="shape=capsule;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=12;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="190" y="210" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Input LK -->
        <mxCell id="node_input_lk" value="Input Laporan Kejadian (LK)&#xa;&amp; Wajib Upload Dokumen PDF LK" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="175" y="290" width="230" height="55" as="geometry" />
        </mxCell>

        <!-- Decision Simpan LK -->
        <mxCell id="node_dec_lk" value="Aksi Simpan LK?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Helvetica;fontStyle=1;fontSize=11;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="210" y="380" width="160" height="65" as="geometry" />
