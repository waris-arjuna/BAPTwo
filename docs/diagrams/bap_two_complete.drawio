        <!-- Trigger Tidak Selesai -->
        <mxCell id="node_trigger_tidak_selesai" value="&lt;b&gt;BATAS TAHUN MUTLAK BERLAKU&lt;/b&gt;&#xa;• Berkas &lt;b&gt;TIDAK DAPAT DIKERJAKAN LAGI&lt;/b&gt;&#xa;  di tahun kalender baru.&#xa;• Sistem otomatis mengubah Status Formal:&#xa;  &lt;b&gt;&quot;TIDAK SELESAI&quot;&lt;/b&gt;&#xa;• Catat Audit Log (Aktor: System Scheduler)" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#7F1D1D;align=left;spacingLeft=12;" vertex="1" parent="1">
