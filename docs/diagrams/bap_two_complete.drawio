        <!-- Input LK to Dec LK -->
        <mxCell id="e_lk_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_input_lk" target="node_dec_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec LK to Draft LK -->
        <mxCell id="e_lk_draft" value="Draft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="node_dec_lk" target="node_draft_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec LK to Final LK -->
        <mxCell id="e_lk_final" value="Finalkan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="node_dec_lk" target="node_final_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Final LK to Input Sprindik -->
        <mxCell id="e_final_lk_sprindik" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_final_lk" target="node_input_sprindik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input Sprindik to Dec 1 LK = 1 Sprindik -->
        <mxCell id="e_sprindik_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="node_input_sprindik" target="node_dec_sprindik_lk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec Sprindik: Sudah dipakai (Ya) -->
        <mxCell id="e_sprindik_err" value="Ya (Sudah dipakai)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#B91C1C;" edge="1" parent="1" source="node_dec_sprindik_lk" target="node_err_lk_used">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dec Sprindik: Belum dipakai (Tidak) -> Bentuk Perkara -->
        <mxCell id="e_sprindik_ok" value="Belum (Valid 1-ke-1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;fontFamily=Helvetica;fontStyle=1;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="node_dec_sprindik_lk" target="node_bentuk_perkara">
